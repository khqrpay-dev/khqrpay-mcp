{
  "name": "khqrpay-mcp",
  "version": "0.1.0",
  "description": "MCP server for KHQRPay: lets AI coding tools create and check KHQR test payments, read payments and check webhook signatures, with your own key.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "khqr",
    "khqrpay",
    "bakong",
    "cambodia",
    "payments",
    "webhook"
  ],
  "homepage": "https://khqrpay.dev/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khqrpay-dev/khqrpay-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/khqrpay-dev/khqrpay-mcp/issues"
  },
  "license": "MIT",
  "author": "KHQRPay (https://khqrpay.dev)",
  "type": "module",
  "bin": {
    "khqrpay-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
